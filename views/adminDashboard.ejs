<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet-routing-machine@latest/dist/leaflet-routing-machine.css" />
    <title>Admin Dashboard | SmartLogist AI</title>
    <style>
        #map { height: 400px; border-radius: 1rem; z-index: 1; }
        .leaflet-routing-container { display: none; } /* Keeps UI clean */
    </style>
</head>
<body class="bg-slate-50 min-h-screen">

    <nav class="bg-[#1a202c] text-white p-4 flex justify-between items-center shadow-lg sticky top-0 z-50">
        <div class="flex items-center gap-3">
            <span class="text-2xl">🛡️</span>
            <h1 class="text-xl font-black uppercase tracking-tighter">SmartLogist <span class="text-blue-400">Admin</span></h1>
        </div>
        <div class="flex items-center gap-4">
            <span class="text-gray-400 text-xs font-mono"><%= adminEmail %></span>
            <a href="/" class="bg-slate-700 hover:bg-red-600 px-4 py-1.5 rounded-lg text-xs font-bold transition">Logout</a>
        </div>
    </nav>

    <div class="max-w-[1600px] mx-auto p-6 grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <div class="lg:col-span-8 space-y-6">
            
            <div class="bg-white p-6 rounded-3xl shadow-sm border border-slate-200">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="font-bold text-slate-700 uppercase text-sm tracking-widest">📍 Live Dispatch Preview</h2>
                    <div id="route-loader" class="hidden text-blue-600 text-xs font-bold animate-pulse">Calculating optimal path...</div>
                </div>
                <div id="map" class="bg-slate-100 border border-slate-200"></div>
                
                <div class="grid grid-cols-3 gap-4 mt-6">
                    <div class="bg-blue-50 p-4 rounded-2xl border border-blue-100">
                        <p class="text-[10px] font-bold text-blue-500 uppercase">AI Recommendation</p>
                        <p id="stat-truck" class="text-lg font-black text-slate-800">---</p>
                    </div>
                    <div class="bg-indigo-50 p-4 rounded-2xl border border-indigo-100">
                        <p class="text-[10px] font-bold text-indigo-500 uppercase">Route Distance</p>
                        <p id="stat-dist" class="text-lg font-black text-slate-800">---</p>
                    </div>
                    <div class="bg-emerald-50 p-4 rounded-2xl border border-emerald-100">
                        <p class="text-[10px] font-bold text-emerald-500 uppercase">Efficiency</p>
                        <p id="stat-score" class="text-lg font-black text-slate-800">---</p>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-3xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="p-6 border-b border-slate-100 flex justify-between items-center">
                    <h3 class="font-bold text-slate-800">Load Requests <span class="text-slate-400 font-normal ml-2">(Owner-Created)</span></h3>
                    <span class="bg-amber-100 text-amber-700 text-[10px] font-black px-2 py-1 rounded-full uppercase">Pending Review</span>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <thead class="bg-slate-50 text-slate-400 text-[10px] font-bold uppercase tracking-widest">
                            <tr>
                                <th class="p-4">Cargo / Owner</th>
                                <th class="p-4">Route (Origin-Dest)</th>
                                <th class="p-4">AI Insight</th>
                                <th class="p-4">Assign Driver</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-50">
                            <% loads.forEach(load => { %>
                            <tr class="hover:bg-slate-50 transition group">
                                <td class="p-4">
                                    <p class="font-bold text-slate-800"><%= load.cargoName %></p>
                                    <p class="text-[10px] text-indigo-500 font-medium"><%= load.ownerEmail %></p>
                                </td>
                                <td class="p-4">
                                    <div class="flex items-center gap-2 text-xs">
                                        <span class="bg-slate-200 px-2 py-1 rounded font-bold"><%= load.origin %></span>
                                        <span class="text-slate-300">→</span>
                                        <span class="bg-blue-100 text-blue-700 px-2 py-1 rounded font-bold"><%= load.destination %></span>
                                    </div>
                                    <p class="text-[10px] text-slate-400 mt-1"><%= load.weight %> kg</p>
                                </td>
                                <td class="p-4">
                                    <button onclick="runAI(event, '<%= load._id %>', '<%= load.origin %>', '<%= load.destination %>')" 
                                            class="bg-amber-400 hover:bg-amber-500 text-white p-2 rounded-full shadow-lg shadow-amber-100 transition active:scale-90">
                                        ✨
                                    </button>
                                </td>
                                <td class="p-4">
                                    <form action="/assign-load" method="POST" class="flex gap-2">
                                        <input type="hidden" name="loadId" value="<%= load._id %>">
                                        <input type="hidden" name="adminEmail" value="<%= adminEmail %>">
                                        <select name="driverId" class="bg-white border border-slate-200 text-[11px] font-bold p-2 rounded-lg outline-none focus:ring-2 focus:ring-blue-500">
                                            <% drivers.forEach(driver => { %>
                                                <option value="<%= driver._id %>"><%= driver.email %></option>
                                            <% }) %>
                                        </select>
                                        <button type="submit" class="bg-slate-800 text-white px-3 py-2 rounded-lg text-[10px] font-bold hover:bg-black transition">Dispatch</button>
                                    </form>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="lg:col-span-4 space-y-6">
            <div class="bg-white p-6 rounded-3xl shadow-sm border border-slate-200">
                <h3 class="font-bold text-slate-700 mb-6 uppercase text-xs tracking-widest flex items-center justify-between">
                    Fleet Overview
                    <span class="text-[10px] bg-slate-100 px-2 py-1 rounded text-slate-500"><%= vehicles.length %> Total</span>
                </h3>
                
                <div class="space-y-4">
                    <% vehicles.forEach(v => { %>
                        <div class="flex items-center justify-between p-4 bg-slate-50 rounded-2xl border border-slate-100">
                            <div>
                                <p class="font-black text-slate-800 text-sm"><%= v.truckNumber %></p>
                                <p class="text-[10px] text-slate-500 font-bold uppercase">Cap: <%= v.capacity %>kg</p>
                            </div>
                            <span class="px-2 py-1 rounded-lg text-[9px] font-black uppercase <%= v.status === 'Available' ? 'bg-green-100 text-green-600' : 'bg-red-100 text-red-600' %>">
                                <%= v.status %>
                            </span>
                        </div>
                    <% }) %>
                </div>
            </div>

            <div class="bg-indigo-600 p-6 rounded-3xl text-white shadow-xl shadow-indigo-100">
                <h3 class="font-bold mb-2">Internal Fleet Add</h3>
                <p class="text-xs text-indigo-200 mb-4 font-medium leading-relaxed">Register company-owned vehicles directly here.</p>
                <form action="/add-vehicle" method="POST" class="space-y-3">
                    <input type="hidden" name="adminEmail" value="<%= adminEmail %>">
                    <input type="text" name="truckNumber" placeholder="Truck Plate" class="w-full bg-indigo-500/50 border-none rounded-xl p-3 text-sm placeholder-indigo-300 outline-none text-white font-bold" required>
                    <input type="number" name="capacity" placeholder="Capacity (kg)" class="w-full bg-indigo-500/50 border-none rounded-xl p-3 text-sm placeholder-indigo-300 outline-none text-white font-bold" required>
                    <button class="w-full bg-white text-indigo-600 font-black py-3 rounded-xl hover:bg-indigo-50 transition active:scale-95">Register System Truck</button>
                </form>
            </div>
        </div>
    </div>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://unpkg.com/leaflet-routing-machine@latest/dist/leaflet-routing-machine.js"></script>
    <script>
        var map = L.map('map').setView([10.0889, 76.3508], 10);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(map);
        let routingControl = null;

        async function getCoords(city) {
            const res = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(city)}`);
            const data = await res.json();
            return data.length > 0 ? L.latLng(data[0].lat, data[0].lon) : null;
        }

        async function runAI(event, loadId, origin, destination) {
            const btn = event.target;
            const loader = document.getElementById('route-loader');
            btn.classList.add('animate-spin');
            loader.classList.remove('hidden');

            try {
                // 1. Plot Route on Map
                if (routingControl) map.removeControl(routingControl);
                const start = await getCoords(origin);
                const end = await getCoords(destination);
                
                if (start && end) {
                    routingControl = L.Routing.control({
                        waypoints: [start, end],
                        routeWhileDragging: false,
                        addWaypoints: false,
                        show: false,
                        fitSelectedRoutes: true
                    }).addTo(map);
                }

                // 2. Fetch AI Dispatch Logic
                const res = await fetch(`/ai-recommend/${loadId}?email=<%= adminEmail %>`);
                const data = await res.json();

                if (data.error) {
                    alert("AI Error: " + data.error);
                } else {
                    document.getElementById('stat-truck').innerText = data.bestVehicle || 'N/A';
                    document.getElementById('stat-dist').innerText = data.distance || 'N/A';
                    document.getElementById('stat-score').innerText = (data.score || '--') + "%";
                }
            } catch (err) {
                console.error(err);
            } finally {
                btn.classList.remove('animate-spin');
                loader.classList.add('hidden');
            }
        }
    </script>
</body>
</html>