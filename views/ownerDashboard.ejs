<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <title>Owner Portal | SmartLogist</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        :root {
            --bg:             #f0f4ff;
            --surface:        #ffffff;
            --surface2:       #f7f9ff;
            --border:         #e2e8f8;
            --border-strong:  #c7d4f0;
            --accent:         #2563eb;
            --accent-light:   #dbeafe;
            --accent-dark:    #1d4ed8;
            --accent2:        #0ea5e9;
            --green:          #059669;
            --green-bg:       #d1fae5;
            --amber:          #d97706;
            --amber-bg:       #fef3c7;
            --red:            #dc2626;
            --indigo:         #6366f1;
            --indigo-bg:      #e0e7ff;
            --text-primary:   #0f172a;
            --text-secondary: #475569;
            --text-muted:     #94a3b8;
            --font-display:   'Syne', sans-serif;
            --font-body:      'DM Sans', sans-serif;
            --radius:         18px;
            --radius-sm:      10px;
            --shadow-sm:      0 1px 3px rgba(37,99,235,0.07), 0 1px 2px rgba(37,99,235,0.04);
            --shadow:         0 4px 20px rgba(37,99,235,0.1);
            --shadow-lg:      0 10px 40px rgba(37,99,235,0.15);
        }
        html { font-size: 14px; }
        body { background: var(--bg); color: var(--text-primary); font-family: var(--font-body); min-height: 100vh; }
        body::before {
            content: ''; position: fixed; inset: 0; z-index: 0; pointer-events: none;
            background:
                radial-gradient(ellipse 900px 500px at 10% 0%, rgba(37,99,235,0.07) 0%, transparent 70%),
                radial-gradient(ellipse 600px 400px at 90% 100%, rgba(14,165,233,0.06) 0%, transparent 70%);
        }

        /* NAV */
        nav {
            position: sticky; top: 0; z-index: 100;
            background: rgba(255,255,255,0.88); backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--border); padding: 0 36px; height: 62px;
            display: flex; align-items: center; justify-content: space-between;
            box-shadow: 0 1px 0 var(--border), 0 4px 24px rgba(37,99,235,0.06);
        }
        .nav-brand { display: flex; align-items: center; gap: 12px; }
        .nav-logo { width: 34px; height: 34px; background: linear-gradient(135deg, var(--accent), var(--accent2)); border-radius: 10px; display: grid; place-items: center; font-size: 15px; box-shadow: 0 4px 12px rgba(37,99,235,0.35); }
        .nav-title { font-family: var(--font-display); font-weight: 800; font-size: 16px; letter-spacing: -0.4px; color: var(--text-primary); }
        .nav-title span { color: var(--accent); }
        .nav-pill { background: var(--accent-light); color: var(--accent); border: 1px solid rgba(37,99,235,0.2); padding: 2px 10px; border-radius: 20px; font-size: 10px; font-weight: 700; letter-spacing: 0.5px; }
        .nav-right { display: flex; align-items: center; gap: 18px; }
        .nav-email { font-size: 11px; color: var(--text-muted); font-family: 'Courier New', monospace; background: var(--surface2); border: 1px solid var(--border); padding: 4px 10px; border-radius: 6px; }
        .nav-logout { background: var(--surface); border: 1px solid var(--border-strong); color: var(--text-secondary); padding: 6px 16px; border-radius: var(--radius-sm); font-size: 11px; font-weight: 600; cursor: pointer; text-decoration: none; transition: all 0.2s; }
        .nav-logout:hover { background: var(--red); border-color: var(--red); color: #fff; }

        /* LAYOUT */
        .layout { max-width: 1300px; margin: 0 auto; padding: 28px 36px; display: grid; grid-template-columns: 320px 1fr; gap: 22px; position: relative; z-index: 1; }
        .col-side { display: flex; flex-direction: column; gap: 22px; }
        .col-main { display: flex; flex-direction: column; gap: 22px; }

        /* CARD */
        .card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow-sm); animation: fadeUp 0.4s ease both; }
        .card:nth-child(2) { animation-delay: 0.06s; }
        @keyframes fadeUp { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }

        .card-header { padding: 18px 22px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; }
        .card-title { font-family: var(--font-display); font-weight: 700; font-size: 13px; color: var(--text-primary); display: flex; align-items: center; gap: 9px; }
        .card-icon { width: 28px; height: 28px; background: var(--accent-light); border-radius: 8px; display: grid; place-items: center; font-size: 13px; }
        .card-body { padding: 22px; }

        /* FORM */
        .form-group { display: flex; flex-direction: column; gap: 10px; }
        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        .input {
            width: 100%; background: var(--surface2); border: 1px solid var(--border);
            color: var(--text-primary); padding: 10px 14px; border-radius: var(--radius-sm);
            font-size: 12px; font-weight: 500; outline: none; font-family: var(--font-body);
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        .input::placeholder { color: var(--text-muted); }
        .input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(37,99,235,0.1); background: var(--surface); }

        .btn { width: 100%; border: none; padding: 11px; border-radius: var(--radius-sm); font-family: var(--font-display); font-weight: 700; font-size: 12px; letter-spacing: 0.3px; cursor: pointer; transition: all 0.2s; }
        .btn-blue { background: var(--accent); color: #fff; box-shadow: 0 2px 10px rgba(37,99,235,0.3); }
        .btn-blue:hover { background: var(--accent-dark); transform: translateY(-1px); box-shadow: 0 4px 16px rgba(37,99,235,0.4); }
        .btn-green { background: var(--green); color: #fff; box-shadow: 0 2px 10px rgba(5,150,105,0.25); }
        .btn-green:hover { background: #047857; transform: translateY(-1px); box-shadow: 0 4px 16px rgba(5,150,105,0.35); }

        /* INFO BOX */
        .info-box { background: var(--accent-light); border: 1px solid rgba(37,99,235,0.2); border-radius: var(--radius); padding: 16px 18px; display: flex; gap: 12px; animation: fadeUp 0.4s ease 0.15s both; }
        .info-box p { font-size: 12px; color: #1e40af; line-height: 1.6; }

        /* BADGE */
        .badge { padding: 3px 9px; border-radius: 20px; font-size: 9px; font-weight: 700; letter-spacing: 0.6px; text-transform: uppercase; white-space: nowrap; }
        .badge-amber  { background: var(--amber-bg);   color: var(--amber);  border: 1px solid rgba(217,119,6,0.25); }
        .badge-green  { background: var(--green-bg);   color: var(--green);  border: 1px solid rgba(5,150,105,0.25); }
        .badge-blue   { background: var(--accent-light); color: var(--accent); border: 1px solid rgba(37,99,235,0.2); }
        .badge-indigo { background: var(--indigo-bg);  color: var(--indigo); border: 1px solid rgba(99,102,241,0.25); }
        .badge-gray   { background: #f1f5f9;            color: var(--text-secondary); border: 1px solid var(--border); }

        /* TABLE */
        .table-wrap { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; }
        thead tr { border-bottom: 1px solid var(--border); background: var(--surface2); }
        thead th { padding: 11px 20px; font-size: 9px; font-weight: 700; letter-spacing: 1.1px; text-transform: uppercase; color: var(--text-muted); text-align: left; }
        tbody tr { border-bottom: 1px solid var(--border); transition: background 0.15s; }
        tbody tr:last-child { border-bottom: none; }
        tbody tr:hover { background: var(--surface2); }
        td { padding: 13px 20px; vertical-align: middle; }

        .cargo-name { font-family: var(--font-display); font-weight: 700; font-size: 13px; color: var(--text-primary); }
        .route-pill { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; }
        .pill-orig { background: #f1f5f9; border: 1px solid var(--border); color: var(--text-secondary); padding: 3px 8px; border-radius: 5px; font-weight: 600; }
        .pill-arr  { color: var(--text-muted); font-size: 10px; }
        .pill-dest { background: var(--accent-light); border: 1px solid rgba(37,99,235,0.2); color: var(--accent); padding: 3px 8px; border-radius: 5px; font-weight: 600; }

        /* PRICE FORM */
        .price-form { display: flex; gap: 6px; align-items: center; }
        .price-input { background: var(--surface2); border: 1px solid var(--border); color: var(--text-primary); padding: 6px 10px; border-radius: var(--radius-sm); font-size: 11px; font-weight: 600; width: 90px; outline: none; font-family: var(--font-body); transition: border-color 0.2s; }
        .price-input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(37,99,235,0.1); }
        .btn-set { background: var(--accent); border: none; color: #fff; padding: 6px 12px; border-radius: var(--radius-sm); font-size: 10px; font-weight: 700; letter-spacing: 0.4px; cursor: pointer; font-family: var(--font-body); transition: all 0.2s; white-space: nowrap; }
        .btn-set:hover { background: var(--accent-dark); }

        /* COUNT CHIP */
        .count-chip { background: var(--surface2); border: 1px solid var(--border); color: var(--text-muted); padding: 3px 9px; border-radius: 20px; font-size: 10px; font-weight: 600; }

        /* EMPTY */
        .empty-state { padding: 44px 20px; text-align: center; color: var(--text-muted); font-size: 12px; }
        .empty-icon { font-size: 30px; margin-bottom: 10px; opacity: 0.4; }

        ::-webkit-scrollbar { width: 5px; height: 5px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: var(--border-strong); border-radius: 3px; }

        @media (max-width: 960px) { .layout { grid-template-columns: 1fr; padding: 16px 18px; } }
    </style>
</head>
<body>

<nav>
    <div class="nav-brand">
        <div class="nav-logo">🏢</div>
        <span class="nav-title">Smart<span>Logist</span></span>
        <span class="nav-pill">Owner</span>
    </div>
    <div class="nav-right">
        <span class="nav-email"><%= user.email %></span>
        <a href="/" class="nav-logout">Sign Out</a>
    </div>
</nav>

<div class="layout">

    <!-- SIDE COLUMN -->
    <div class="col-side">
        <!-- REQUEST LOAD -->
        <div class="card">
            <div class="card-header">
                <span class="card-title"><span class="card-icon">📦</span>Request New Load</span>
            </div>
            <div class="card-body">
                <form action="/owner/create-load" method="POST" class="form-group">
                    <input type="hidden" name="ownerEmail" value="<%= user.email %>">
                    <input type="text"   name="cargoName"  placeholder="Cargo Name"   class="input" required>
                    <div class="form-row">
                        <input type="text" name="origin"      placeholder="Origin"      class="input" required>
                        <input type="text" name="destination" placeholder="Destination" class="input" required>
                    </div>
                    <input type="number" name="weight" placeholder="Weight (kg)" class="input" required>
                    <button type="submit" class="btn btn-green">Post Load for Dispatch</button>
                </form>
            </div>
        </div>

        <!-- INFO -->
        <div class="info-box">
            <span style="font-size:18px;flex-shrink:0;">ℹ️</span>
            <p><strong>Dispatch Note:</strong> Once you create a load, it will appear on the <strong>Admin Dashboard</strong>. The Admin will use AI to assign the best available vehicle and driver to your request.</p>
        </div>

    </div>

    <!-- MAIN COLUMN -->
    <div class="col-main">
        <div class="card">
            <div class="card-header">
                <span class="card-title"><span class="card-icon">📋</span>My Load Requests</span>
                <span class="count-chip"><%= myLoads.length %> Loads</span>
            </div>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Cargo</th>
                            <th>Route</th>
                            <th>Weight</th>
                            <th>Status</th>
                            <th>Owner Price</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if(myLoads.length === 0) { %>
                        <tr><td colspan="5"><div class="empty-state"><div class="empty-icon">📭</div>No load requests yet</div></td></tr>
                        <% } %>
                        <% myLoads.forEach(load => { %>
                        <tr>
                            <td><div class="cargo-name"><%= load.cargoName %></div></td>
                            <td>
                                <div class="route-pill">
                                    <span class="pill-orig"><%= load.origin %></span>
                                    <span class="pill-arr">→</span>
                                    <span class="pill-dest"><%= load.destination %></span>
                                </div>
                            </td>
                            <td style="font-size:12px;color:var(--text-secondary);font-weight:500;"><%= load.weight %> kg</td>
                            <td>
                                <%
                                    let sc = 'badge-gray';
                                    if(load.status === 'Pending')   sc = 'badge-amber';
                                    if(load.status === 'Assigned')  sc = 'badge-blue';
                                    if(load.status === 'Picked Up') sc = 'badge-indigo';
                                    if(load.status === 'Delivered') sc = 'badge-green';
                                %>
                                <span class="badge <%= sc %>"><%= load.status %></span>
                            </td>
                            <td>
                                <form action="/set-owner-price" method="POST" class="price-form">
                                    <input type="hidden" name="loadId"     value="<%= load._id %>">
                                    <input type="hidden" name="ownerEmail" value="<%= user.email %>">
                                    <input type="number" name="ownerPrice" value="<%= load.ownerPrice || '' %>" placeholder="₹ price" class="price-input" required>
                                    <button type="submit" class="btn-set">Set</button>
                                </form>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
</body>
</html>