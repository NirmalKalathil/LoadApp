<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <title>Owner Dashboard | SmartLogist</title>
</head>
<body class="bg-slate-50 min-h-screen">
    <nav class="bg-indigo-900 text-white p-4 flex justify-between items-center shadow-lg">
        <h1 class="text-xl font-bold tracking-tight">OWNER PORTAL</h1>
        <div class="flex items-center gap-4">
            <span class="text-indigo-200 text-sm"><%= user.email %></span>
            <a href="/" class="bg-indigo-800 hover:bg-red-600 px-3 py-1 rounded text-xs transition">Logout</a>
        </div>
    </nav>

    <div class="max-w-7xl mx-auto p-6">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            
            <div class="space-y-6">
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                    <h2 class="font-bold text-slate-700 mb-4 flex items-center gap-2">
                        <span>🚛</span> REGISTER VEHICLE
                    </h2>
                    <form action="/add-vehicle" method="POST" class="space-y-4">
                        <input type="hidden" name="adminEmail" value="<%= user.email %>">
                        <input type="text" name="truckNumber" placeholder="Plate (e.g., KL-01-9999)" class="w-full p-2.5 bg-slate-50 border rounded-lg outline-none focus:ring-2 focus:ring-indigo-500" required>
                        <input type="number" name="capacity" placeholder="Capacity (kg)" class="w-full p-2.5 bg-slate-50 border rounded-lg outline-none focus:ring-2 focus:ring-indigo-500" required>
                        <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 rounded-lg transition">Add to Fleet</button>
                    </form>
                </div>

                <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                    <h2 class="font-bold text-slate-700 mb-4 flex items-center gap-2">
                        <span>📦</span> REQUEST NEW LOAD
                    </h2>
                    <form action="/owner/create-load" method="POST" class="space-y-4">
                        <input type="hidden" name="ownerEmail" value="<%= user.email %>">
                        <input type="text" name="cargoName" placeholder="Cargo Name" class="w-full p-2.5 bg-slate-50 border rounded-lg outline-none focus:ring-2 focus:ring-indigo-500" required>
                        <div class="grid grid-cols-2 gap-2">
                            <input type="text" name="origin" placeholder="Origin" class="p-2.5 bg-slate-50 border rounded-lg outline-none focus:ring-2 focus:ring-indigo-500" required>
                            <input type="text" name="destination" placeholder="Destination" class="p-2.5 bg-slate-50 border rounded-lg outline-none focus:ring-2 focus:ring-indigo-500" required>
                        </div>
                        <input type="number" name="weight" placeholder="Weight (kg)" class="w-full p-2.5 bg-slate-50 border rounded-lg outline-none focus:ring-2 focus:ring-indigo-500" required>
                        <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2 rounded-lg transition shadow-lg shadow-emerald-100">Post Load for Dispatch</button>
                    </form>
                </div>
            </div>

            <div class="lg:col-span-2 space-y-6">
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                    <div class="p-4 bg-slate-50 border-b flex justify-between items-center">
                        <h3 class="font-bold text-slate-700">MY ACTIVE FLEET</h3>
                        <span class="bg-indigo-100 text-indigo-700 text-[10px] font-black px-2 py-1 rounded"><%= myVehicles.length %> TRUCKS</span>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left">
                            <thead class="bg-slate-50 text-slate-400 text-[10px] font-bold uppercase">
                                <tr>
                                    <th class="p-4">Truck Plate</th>
                                    <th class="p-4">Capacity</th>
                                    <th class="p-4">Current Status</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                <% myVehicles.forEach(v => { %>
                                <tr class="hover:bg-slate-50 transition">
                                    <td class="p-4 font-mono font-bold text-slate-800"><%= v.truckNumber %></td>
                                    <td class="p-4 text-slate-600"><%= v.capacity %> kg</td>
                                    <td class="p-4">
                                        <span class="px-3 py-1 rounded-full text-[10px] font-black uppercase <%= v.status === 'Available' ? 'bg-green-100 text-green-700' : 'bg-amber-100 text-amber-700' %>">
                                            <%= v.status %>
                                        </span>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="bg-blue-50 border border-blue-100 p-4 rounded-xl flex gap-3">
                    <span class="text-xl">ℹ️</span>
                    <p class="text-sm text-blue-700 leading-relaxed">
                        <strong>Dispatch Note:</strong> Once you create a load, it will appear on the <strong>Admin Dashboard</strong>. The Admin will use AI to assign the best available vehicle and driver to your request.
                    </p>
                </div>
            </div>

        </div>
    </div>
</body>
</html>